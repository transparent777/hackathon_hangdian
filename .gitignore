# =========================
# Agent Skills（本地安装，体积大）
# =========================
.agents/

# =========================
# 依赖（不要提交）
# =========================
node_modules/
miniprogram/node_modules/
miniprogram/miniprogram_npm/
**/miniprogram_npm/

# =========================
# 密钥 & 环境变量（最重要）
# =========================
.env
.env.*
.env.local
.env.*.local
!.env.example
!**/.env.example

# 本地密钥配置文件
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/secrets.*
**/*.secret
**/*.secrets
**/config.local.js
**/config.local.json
**/*.local.json
**/*.local.js

# npm / 包管理器鉴权（可能含 token）
.npmrc
!.npmrc.example

# AI / 云服务凭证
ai/.credentials/
ai/credentials.*
server/.credentials/
server/credentials.*

# 微信云开发 / 腾讯云本地配置
**/cloudbaserc.local.json
**/tcb_custom_login_key/
**/tcb_custom_login_key.json

# Postman / Apifox 环境文件（常含 API Key）
*postman_environment*.json
*.apifox.json

# 常见密钥文件后缀
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
private.*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.crt
*.cer
!**/*.example.key

# =========================
# 微信小程序私有配置（含 AppID）
# =========================
miniprogram/project.private.config.json
**/project.private.config.json

# 微信上传密钥（若使用 CI 上传）
private.*.key

# =========================
# 日志 & 临时文件
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.tmp/
temp/
cache/

# =========================
# Server 运行时
# =========================
server/node_modules/
server/uploads/*
!server/uploads/.gitkeep

# 本地数据库（可能含 openid / 用户数据）
*.sqlite
*.sqlite3
*.db

# =========================
# 构建产物
# =========================
dist/
build/
.output/
.serverless/

# =========================
# 操作系统
# =========================
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# IDE / 编辑器
# =========================
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# VS Code：忽略个人配置，保留推荐扩展（可选）
.vscode/*
!.vscode/extensions.json

# Cursor（本地会话；规则目录 .cursor/rules 若需共享可单独 un-ignore）
.cursor/
!.cursor/rules/

# =========================
# 测试 & 覆盖率
# =========================
coverage/
.nyc_output/

# =========================
# 素材库 & 溶图参考图（本地源文件，不进 Git）
# =========================
# 素材库：封面视频、主页 banner、陪伴兽原图、溶图多角度素材等
# 同步脚本：scripts/sync_assets.py · scripts/sync_blend_assets.py
素材库/

# 溶图 API 参考图（从 素材库/溶图 同步到本地；仅保留 README 说明）
ai/references/**
!ai/references/
!ai/references/README.md

# 开场视频高清源（本地备份，不提交）
miniprogram/assets/splash/intro-source-*.mp4

# 用户本地溶图 / 调试缓存（wxfile、临时导出）
miniprogram/temp/
miniprogram/cache/

# =========================
# 其他敏感或大文件（按需）
# =========================
# 用户上传的测试原图（全局 uploads 目录）
uploads/
**/uploads/*
!**/uploads/.gitkeep

# 调试转储
*.heapdump
core.*

# 打包压缩包
*.zip
*.tar.gz
*.rar
