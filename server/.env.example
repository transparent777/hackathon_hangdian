# 复制为 .env 后填写密钥（.env 已在 .gitignore，勿提交）

PORT=3000
MAX_UPLOAD_BYTES=10485760

# --- 角色融入 ---
AI_MODE=live
# 默认 hybrid：DeepSeek 分析场景 + 透明角色素材确定性合成，背景不重绘
AI_BLEND_STRATEGY=hybrid

# 仅 seedream-full 兼容策略需要以下火山方舟配置
AI_API_KEY=
AI_API_BASE_URL=https://ark.cn-beijing.volces.com

# lite/pro 需在控制台开通；旧整图策略建议 pro
AI_BLEND_VARIANT=pro
# AI_BLEND_VARIANT=4.5
# AI_BLEND_VARIANT=lite

AI_BLEND_SIZE=2K
AI_BLEND_WATERMARK=false
AI_TIMEOUT_MS=90000

# --- DeepSeek · 陪伴日记多模态 ---
AI_DIARY_API_KEY=
AI_DIARY_API_BASE_URL=https://api.deepseek.com
AI_DIARY_MODEL=deepseek-flash

PUBLIC_BASE_URL=http://127.0.0.1:3000
