# 复制为 .env 后填写（.env 已在 .gitignore，勿提交）

PORT=3000
MAX_UPLOAD_BYTES=10485760

# CORS_ORIGINS=https://servicewechat.com

# --- 火山方舟 · 豆包 Seedream 5.0 ---
AI_MODE=live
AI_API_KEY=
AI_API_BASE_URL=https://ark.cn-beijing.volces.com

# 溶图模型：lite（默认）| pro | 4.5；或直接写完整 model id 覆盖
AI_BLEND_VARIANT=lite
# AI_BLEND_VARIANT=pro
# AI_BLEND_MODEL=doubao-seedream-5-0-pro-260628

# lite: 2K / 3K / 4K；pro: 1K / 2K
AI_BLEND_SIZE=2K
AI_BLEND_WATERMARK=true

AI_DIARY_MODEL=
AI_TIMEOUT_MS=90000
PUBLIC_BASE_URL=http://localhost:3000
