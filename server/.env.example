# 复制为 .env 后填写密钥（.env 已在 .gitignore，勿提交）

PORT=3000
MAX_UPLOAD_BYTES=10485760

# CORS_ORIGINS=https://servicewechat.com

# --- 火山方舟 · 豆包 Seedream 5.0 溶图 ---
AI_MODE=live
AI_API_KEY=
AI_API_BASE_URL=https://ark.cn-beijing.volces.com

# lite（默认）| pro | 4.5；或直接写 AI_BLEND_MODEL 覆盖
AI_BLEND_VARIANT=lite
# AI_BLEND_VARIANT=pro
# AI_BLEND_MODEL=doubao-seedream-5-0-pro-260628

# lite: 2K / 3K / 4K；pro: 1K / 2K
AI_BLEND_SIZE=2K
AI_BLEND_WATERMARK=true

AI_TIMEOUT_MS=90000

# --- DeepSeek V4.1-Flash · 陪伴日记多模态 ---
AI_DIARY_API_KEY=
AI_DIARY_API_BASE_URL=https://api.deepseek.com
AI_DIARY_MODEL=deepseek-flash
# AI_DIARY_TIMEOUT_MS=45000

# 返回给小程序的图片 URL 前缀
# 本地：http://localhost:3000
# 真机：http://192.168.x.x:3000
PUBLIC_BASE_URL=http://localhost:3000
