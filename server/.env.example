# 复制为 .env 后填写密钥（.env 已在 .gitignore，勿提交）

PORT=3000
MAX_UPLOAD_BYTES=10485760

# --- 角色融入 ---
AI_MODE=live
# 默认 hybrid：Seedream Pro 生成一次候选图，U2Net 本地分割角色，再覆盖回原始背景
AI_BLEND_STRATEGY=seedream-full
# asset-composite：不调用 Seedream，直接选择透明动作素材合成
# seedream-full：默认直接返回 Seedream 完整候选图，背景可能被轻微重绘

# hybrid 和 seedream-full 都需要以下火山方舟配置
AI_API_KEY=
AI_API_BASE_URL=https://ark.cn-beijing.volces.com

# lite/pro 需在控制台开通；候选图直出建议 pro
AI_BLEND_VARIANT=pro
# AI_BLEND_VARIANT=4.5
# AI_BLEND_VARIANT=lite

AI_BLEND_SIZE=2K
AI_BLEND_WATERMARK=false
AI_TIMEOUT_MS=90000
# hybrid 提取失败时是否显式降级；seedream-full 生成失败始终返回 candidate_generation 错误
AI_ALLOW_ASSET_FALLBACK=true

# --- 本地角色分割（hybrid）---
AI_SEGMENT_MODEL_PATH=models/u2netp.onnx
AI_SEGMENT_PYTHON=python

# --- DeepSeek · 陪伴日记多模态 ---
AI_DIARY_API_KEY=
AI_DIARY_API_BASE_URL=https://api.deepseek.com
AI_DIARY_MODEL=deepseek-flash

PUBLIC_BASE_URL=http://127.0.0.1:3000
