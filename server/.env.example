# 复制为 .env 后填写（.env 已在 .gitignore，勿提交）

PORT=3000
MAX_UPLOAD_BYTES=10485760

# CORS_ORIGINS=https://servicewechat.com

# --- 火山方舟 · 豆包 Seedream 4.5 ---
AI_MODE=live
AI_API_KEY=
AI_API_BASE_URL=https://ark.cn-beijing.volces.com
AI_BLEND_MODEL=doubao-seedream-4-5-251128
AI_BLEND_SIZE=2K
AI_BLEND_WATERMARK=true

# 日记多模态（暂未接入，溶图后仍用 fallback 文案）
AI_DIARY_MODEL=
AI_TIMEOUT_MS=90000

# 返回给小程序的图片 URL 前缀
# 本地：http://localhost:3000
# 真机：http://192.168.x.x:3000
PUBLIC_BASE_URL=http://localhost:3000
