# 复制为 .env 后填写（.env 已被 gitignore，不会提交）
PORT=3000

# 多模态日记批注（接入时填写其一即可）
AI_API_KEY=
AI_API_BASE_URL=
AI_VISION_MODEL=

# 溶图服务（若与日记分开）
BLEND_API_KEY=
BLEND_API_BASE_URL=

# 对象存储（OSS / COS，上线时用）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=

# 安全：生产环境限制 CORS 来源（逗号分隔，留空则开发模式允许所有）
CORS_ORIGINS=

# 上传限制（字节，默认 10MB）
MAX_UPLOAD_BYTES=10485760
