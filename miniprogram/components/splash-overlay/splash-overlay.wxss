.splash {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: #fff9f0;
  z-index: 10000;
}

.splash-video-wrap {
  width: 100vw;
  height: 100vh;
  background: #fff9f0;
}

.splash--leave {
  opacity: 0;
  transition: opacity 0.35s ease;
}

.splash-video {
  width: 100vw;
  height: 100vh;
}

.skip-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.skip-hint {
  position: absolute;
  right: 32rpx;
  bottom: calc(48rpx + constant(safe-area-inset-bottom));
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
}

.tap-play-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
}

.tap-play-hint {
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(45, 52, 54, 0.82);
  border-radius: 999rpx;
}

.splash-loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff9f0;
  z-index: 1;
}

.splash-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #fff9f0 0%, #fff3e0 100%);
}

.brand-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #2d3436;
  letter-spacing: 4rpx;
}

.brand-tag {
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #2d3436;
  background: #ffe66d;
  border: 3rpx solid #2d3436;
  border-radius: 999rpx;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #b2bec3;
}

.splash-fallback .loading-text {
  color: #636e72;
}
