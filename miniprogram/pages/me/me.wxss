.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.profile-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: var(--border-sketch);
  background: rgba(108, 92, 231, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card__name {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-card__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.feature-card {
  padding: 28rpx;
}

.feature-card--active:active {
  transform: scale(0.98);
}

.feature-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feature-card__title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
}

.feature-card__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
  padding-left: 36rpx;
}

.info-card {
  margin-bottom: 8rpx;
}

.info-item {
  padding: 16rpx 0;
  border-bottom: 2rpx dashed rgba(45, 52, 54, 0.12);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item__title {
  font-size: 28rpx;
  font-weight: 700;
}

.info-item__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
