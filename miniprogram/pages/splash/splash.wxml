<view class="splash {{leaving ? 'splash--leave' : ''}}" bind:tap="onTapSkip">
  <view class="splash-bg">
    <view class="blob blob-1"></view>
    <view class="blob blob-2"></view>
    <view class="blob blob-3"></view>
  </view>

  <view class="splash-content {{started ? 'splash-content--in' : ''}}">
    <view class="logo-wrap">
      <view class="camera-icon">
        <view class="camera-body"></view>
        <view class="camera-lens"></view>
        <view class="camera-flash"></view>
      </view>
    </view>

    <view class="brand-title">赛博陪伴相机</view>
    <view class="brand-tag">CYBER PET</view>

    <view class="companions">
      <image
        class="companion companion-1"
        src="/images/characters/naiwa.jpg"
        mode="aspectFill"
      />
      <image
        class="companion companion-2"
        src="/images/characters/doro.jpg"
        mode="aspectFill"
      />
      <image
        class="companion companion-3"
        src="/images/characters/maodie.jpg"
        mode="aspectFill"
      />
    </view>

    <view class="loading-line">
      <view class="loading-bar"></view>
    </view>
    <view class="loading-text">正在召唤今日陪伴兽...</view>
    <view class="skip-hint">点击任意处跳过</view>
  </view>
</view>
