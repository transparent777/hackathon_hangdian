.page-header {
  margin-bottom: 24rpx;
}

.page-header__title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-header__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.history-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.history-card {
  padding: 12rpx;
  overflow: hidden;
}

.history-card__img {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  border: 2rpx solid #2d3436;
}

.history-card__meta {
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.history-card__name {
  font-size: 26rpx;
  font-weight: 700;
}

.history-card__quote {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  margin-top: 40rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-state__sub {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}
