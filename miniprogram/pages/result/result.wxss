.polaroid {
  padding: 24rpx;
  background: #fff;
}

.photo-frame {
  position: relative;
  width: 100%;
  height: 640rpx;
  border: var(--border-sketch);
  border-radius: 20rpx;
  overflow: hidden;
  background: #f1f2f6;
}

.bg-photo {
  width: 100%;
  height: 100%;
}

.blend-status {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(25, 25, 25, 0.82);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.2;
}

.degraded-notice {
  margin-top: 18rpx;
  color: #a33a2b;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.character-sticker {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 220rpx;
  height: 220rpx;
  border: var(--border-sketch);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-soft);
}

.polaroid-caption {
  margin-top: 24rpx;
  text-align: center;
}

.caption-name {
  font-size: 36rpx;
  font-weight: 800;
}

.caption-quote {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

