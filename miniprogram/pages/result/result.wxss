.polaroid {
  padding: 24rpx;
  background: #fff;
}

.photo-frame {
  position: relative;
  width: 100%;
  height: 640rpx;
  border: var(--border-sketch);
  border-radius: 20rpx;
  overflow: hidden;
  background: #f1f2f6;
}

.bg-photo {
  width: 100%;
  height: 100%;
}

.character-sticker {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 220rpx;
  height: 220rpx;
  border: var(--border-sketch);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-soft);
}

.polaroid-caption {
  margin-top: 24rpx;
  text-align: center;
}

.caption-name {
  font-size: 36rpx;
  font-weight: 800;
}

.caption-quote {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.share-btn {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 999rpx;
  border: 3rpx solid #2d3436;
  background: var(--color-accent);
  font-size: 30rpx;
  font-weight: 700;
  color: #2d3436;
}

.share-btn::after {
  border: none;
}

.outline-btn {
  border: 3rpx solid #2d3436 !important;
  color: #2d3436 !important;
  font-weight: 700 !important;
}
