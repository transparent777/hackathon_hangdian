.polaroid {
  padding: 24rpx;
  background: #fff;
}

.photo-frame {
  position: relative;
  width: 100%;
  height: 640rpx;
  border: var(--border-sketch);
  border-radius: 20rpx;
  overflow: hidden;
  background: #f1f2f6;
}

.bg-photo {
  width: 100%;
  height: 100%;
}

.character-sticker {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid #2d3436;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 2rpx 4rpx 0 rgba(45, 52, 54, 0.12);
}

.polaroid-caption {
  margin-top: 24rpx;
  text-align: center;
}

.caption-name {
  font-size: 36rpx;
  font-weight: 800;
}

.caption-quote {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

