<view class="container">
  <view class="card">
    <view class="title">{{characterName}} 来陪你了</view>
    <view class="subtitle">「{{quote}}」</view>
  </view>

  <view class="card image-card">
    <image class="result-image" src="{{imageUrl}}" mode="widthFix" />
  </view>

  <van-button class="primary-btn" type="primary" color="#6C5CE7" block round bind:click="saveImage">
    保存到相册
  </van-button>

  <van-button class="primary-btn" type="default" block round bind:click="goHome">
    再拍一张
  </van-button>
</view>
