<view class="page-bg">
  <view class="container">
    <view class="polaroid card card--tilt-left">
      <view class="photo-frame">
        <image class="bg-photo" src="{{imageUrl}}" mode="aspectFill" />
        <view class="blend-status" wx:if="{{degraded}}">基础合成</view>
      </view>
      <view class="degraded-notice" wx:if="{{degraded}}">AI 动作生成未完成，本图使用预设角色素材</view>
      <view class="polaroid-caption">
        <view class="caption-name">{{characterName}}</view>
        <view class="caption-quote">「{{quote}}」</view>
      </view>
    </view>

    <view class="action-group">
      <action-pill
        variant="primary"
        text="保存到相册"
        catch:tap="saveImage"
      />
      <action-pill
        variant="accent"
        text="分享给朋友"
        icon="share-o"
        open-type="share"
      />
      <action-pill
        wx:if="{{!isHistoryView}}"
        variant="secondary"
        text="再拍一张"
        icon="photograph"
        catch:tap="retakePhoto"
      />
      <action-pill
        wx:if="{{!isHistoryView}}"
        variant="secondary"
        text="返回首页"
        icon="wap-home-o"
        catch:tap="goHome"
      />
    </view>
  </view>
</view>
