.hero-banner {
  position: relative;
  height: 360rpx;
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.hero-banner--fallback {
  background: linear-gradient(135deg, #6c5ce7 0%, #74b9ff 50%, #ffe66d 100%);
}

.hero-banner__img {
  width: 100%;
  height: 100%;
}

.hero-banner__overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(45, 52, 54, 0.55));
}

.hero-banner__tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #2d3436;
  background: #ffe66d;
  border: 2rpx solid #2d3436;
  border-radius: 999rpx;
}

.hero-banner__title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.hero-banner__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.blend-cta {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #6c5ce7 !important;
}

.blend-cta__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #ffe66d;
  border: 4rpx solid #2d3436;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #2d3436;
}

.blend-cta__inner--disabled {
  background: #f1f2f6;
  color: #b2bec3;
}

.blend-cta__hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.dual-panel {
  display: flex;
  gap: 20rpx;
}

.panel {
  flex: 1;
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.panel__label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.panel__icon-wrap {
  margin-top: 24rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: var(--border-sketch);
  background: rgba(108, 92, 231, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel__action {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.panel__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.panel--roll:active {
  transform: scale(0.98) rotate(-1deg);
}

.companion-portrait {
  margin-top: 20rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: var(--border-sketch);
  overflow: hidden;
  background: #fff;
}

.companion-portrait__img {
  width: 100%;
  height: 100%;
}

.rarity-tag {
  margin-top: 12rpx;
  font-weight: 700 !important;
}

.companion-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.companion-name--muted {
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 600;
}

.companion-empty {
  margin-top: 32rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: var(--border-sketch);
  background: #f1f2f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #b2bec3;
}
