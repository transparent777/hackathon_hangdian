.hero {
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.hero-tag {
  border: 2rpx solid #2d3436 !important;
  font-weight: 700 !important;
}

.companion {
  margin-top: 8rpx;
  text-align: center;
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.companion.empty {
  background: #fff !important;
}

.rarity-tag {
  margin-bottom: 20rpx;
  font-weight: 700 !important;
}

.portrait-wrap {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: var(--border-sketch);
  overflow: hidden;
  background: #fff;
  box-shadow: var(--shadow-soft);
}

.portrait {
  width: 100%;
  height: 100%;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: var(--border-sketch);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 800;
  background: var(--color-accent);
}

.name {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.quote {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-muted);
  padding: 0 24rpx;
  line-height: 1.6;
}

.outline-btn {
  border: 3rpx solid #2d3436 !important;
  color: #2d3436 !important;
  font-weight: 700 !important;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
}

.history-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  border: 2rpx solid #2d3436;
  flex-shrink: 0;
}

.history-meta {
  flex: 1;
  min-width: 0;
}

.history-name {
  font-size: 28rpx;
  font-weight: 700;
}

.history-quote {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mock-tip {
  margin-top: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.6;
  background: rgba(108, 92, 231, 0.06) !important;
}
