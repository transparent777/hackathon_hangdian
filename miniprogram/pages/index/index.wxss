.hero {
  margin-bottom: 24rpx;
}

.companion {
  margin-top: 24rpx;
  text-align: center;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.companion.empty {
  opacity: 0.9;
}

.roll-tag {
  font-size: 22rpx;
  color: #6c5ce7;
  background: rgba(108, 92, 231, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}

.emoji {
  font-size: 96rpx;
  line-height: 1.2;
}

.name {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.quote {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #636e72;
  padding: 0 24rpx;
}
