.container--home {
  padding-top: 8rpx;
}

/* Banner 相框：完整展示，不裁切顶部 CYBER 字样 */
.hero-banner {
  padding: 20rpx;
  margin-bottom: 24rpx;
  background: #fff !important;
}

.hero-banner__frame {
  border: 4rpx solid #2d3436;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff9f0;
  box-shadow: inset 0 0 0 8rpx rgba(255, 230, 109, 0.35);
}

.hero-banner__frame--fallback {
  min-height: 360rpx;
  background: linear-gradient(160deg, #6c5ce7 0%, #74b9ff 55%, #fff9f0 100%);
}

.hero-banner__img {
  display: block;
  width: 100%;
  vertical-align: top;
}

/* 溶图胶囊条：参考 JuJuly 蓝色横条 */
.blend-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
  background: #3d5a80;
  border: 4rpx solid #2d3436;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 0 rgba(45, 52, 54, 0.12);
}

.blend-pill--disabled {
  opacity: 0.55;
}

.blend-pill__dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ffe66d;
  border: 2rpx solid #2d3436;
  flex-shrink: 0;
}

.blend-pill__main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 16rpx;
  padding: 14rpx 24rpx;
  background: #ffe66d;
  border: 3rpx solid #2d3436;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #2d3436;
}

.blend-hint {
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #636e72;
}

.dual-panel {
  display: flex;
  gap: 20rpx;
}

.panel {
  flex: 1;
  min-height: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.panel__label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6c5ce7;
  letter-spacing: 2rpx;
}

.panel__icon-wrap {
  margin-top: 24rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #2d3436;
  background: rgba(108, 92, 231, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel__action {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.panel__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #636e72;
}

.panel--roll:active {
  transform: scale(0.98) rotate(-1deg);
}

/* 圆形陪伴兽头像 */
.companion-portrait {
  margin-top: 20rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 4rpx solid #2d3436;
  overflow: hidden;
  background: #fff;
}

.companion-portrait__img {
  width: 100%;
  height: 100%;
}

.rarity-tag {
  margin-top: 14rpx;
  font-weight: 700 !important;
}

.companion-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.companion-name--muted {
  color: #636e72;
  font-size: 26rpx;
  font-weight: 600;
}

.companion-empty {
  margin-top: 32rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 4rpx solid #2d3436;
  background: #f1f2f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #b2bec3;
}
