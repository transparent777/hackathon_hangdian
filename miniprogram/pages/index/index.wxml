<view class="page-bg tab-page">
  <view class="container container--home">
    <!-- Banner：手绘边框卡片，完整展示不裁切 -->
    <view class="hero-banner card card--tilt-left">
      <view class="hero-banner__frame {{bannerSrc ? '' : 'hero-banner__frame--fallback'}}">
        <image
          wx:if="{{bannerSrc}}"
          class="hero-banner__img"
          src="{{bannerSrc}}"
          mode="widthFix"
          binderror="onBannerError"
        />
      </view>
    </view>

    <!-- 溶图入口：蓝色胶囊条（参考图中间那条） -->
    <view
      class="blend-pill {{companion ? '' : 'blend-pill--disabled'}}"
      bind:tap="goCamera"
    >
      <view class="blend-pill__dot"></view>
      <view class="blend-pill__main">
        <van-icon name="photograph" size="20px" color="#2D3436" />
        <text>进入溶图</text>
      </view>
      <view class="blend-pill__dot"></view>
    </view>
    <view class="blend-hint" wx:if="{{!companion}}">请先抽取今日陪伴兽</view>

    <!-- 左 Roll + 右陪伴兽（圆形头像） -->
    <view class="dual-panel">
      <view class="panel panel--roll card card--tilt-left" bind:tap="onRoll">
        <view class="panel__label">抽取陪伴兽</view>
        <view class="panel__icon-wrap">
          <van-loading wx:if="{{rolling}}" size="28px" color="#6C5CE7" />
          <van-icon wx:else name="gift-o" size="36px" color="#6C5CE7" />
        </view>
        <view class="panel__action">{{companion ? '重新抽取' : '点击抽取'}}</view>
        <view class="panel__sub">每日随机一只</view>
      </view>

      <view class="panel panel--companion card card--tilt-right">
        <view class="panel__label">今日陪伴兽</view>
        <block wx:if="{{companion}}">
          <view class="companion-portrait" style="box-shadow: 0 8rpx 0 {{companion.accent}};">
            <image class="companion-portrait__img" src="{{companion.image}}" mode="aspectFill" />
          </view>
          <van-tag color="{{companion.rarityColor}}" custom-class="rarity-tag">{{companion.rarity}}</van-tag>
          <view class="companion-name">{{companion.name}}</view>
        </block>
        <block wx:else>
          <view class="companion-empty">?</view>
          <view class="companion-name companion-name--muted">等待抽取</view>
        </block>
      </view>
    </view>
  </view>
</view>
