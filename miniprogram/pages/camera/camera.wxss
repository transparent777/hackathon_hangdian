.preview {
  margin-top: 24rpx;
  min-height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview.empty {
  color: #b2bec3;
  font-size: 28rpx;
}

.preview-image {
  width: 100%;
  max-height: 600rpx;
  border-radius: 16rpx;
}

.loading-tip {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #636e72;
  font-size: 26rpx;
}
