<view class="page-bg">
  <view class="container">
    <view class="card header card--tilt-left">
      <view class="header-row">
        <image class="mini-avatar" src="{{characterImage}}" mode="aspectFill" />
        <view>
          <view class="brand-title">和 {{characterName}} 合影</view>
          <view class="brand-subtitle">拍一张或从相册选一张，溶进你的场景</view>
        </view>
      </view>
    </view>

    <view class="preview card card--tilt-right" wx:if="{{imagePath}}">
      <image class="preview-image" src="{{imagePath}}" mode="aspectFill" />
      <image class="sticker-preview" src="{{characterImage}}" mode="aspectFit" />
    </view>

    <view class="preview card empty card--tilt-right" wx:else>
      <van-icon name="photograph" size="48px" color="#B2BEC3" />
      <view class="placeholder">还没有选图</view>
    </view>

    <view class="action-group">
      <action-pill
        variant="primary"
        text="拍照 / 从相册选择"
        icon="photograph"
        bind:tap="chooseImage"
      />
      <action-pill
        variant="secondary"
        text="开始溶图"
        loading-text="溶图中..."
        disabled="{{!imagePath || blending}}"
        loading="{{blending}}"
        bind:tap="onBlend"
      />
    </view>
  </view>

  <van-overlay show="{{blending}}" z-index="100">
    <view class="overlay-panel">
      <view class="loading-chat card">
        <view class="loading-chat__row">
          <image class="loading-chat__avatar" src="{{characterImage}}" mode="aspectFill" />
          <view class="loading-chat__bubble loading-chat__bubble--{{characterId}}">
            <text class="loading-chat__quote">「{{loadingQuote}}」</text>
          </view>
        </view>
        <view class="loading-chat__footer">
          <van-loading size="20px" color="#6C5CE7" />
          <text class="loading-chat__hint">{{characterName}} 正在溶进你的生活…</text>
        </view>
      </view>
    </view>
  </van-overlay>
</view>
