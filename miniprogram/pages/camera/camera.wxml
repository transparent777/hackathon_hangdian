<view class="page-bg">
  <view class="container">
    <view class="card header card--tilt-left">
      <view class="header-row">
        <image class="mini-avatar" src="{{characterImage}}" mode="aspectFill" />
        <view>
          <view class="brand-title">和 {{characterName}} 合影</view>
          <view class="brand-subtitle">拍一张或从相册选一张，溶进你的场景</view>
        </view>
      </view>
    </view>

    <view class="preview card card--tilt-right" wx:if="{{imagePath}}">
      <image class="preview-image" src="{{imagePath}}" mode="aspectFill" />
      <image class="sticker-preview" src="{{characterImage}}" mode="aspectFit" />
    </view>

    <view class="preview card empty card--tilt-right" wx:else>
      <van-icon name="photograph" size="48px" color="#B2BEC3" />
      <view class="placeholder">还没有选图</view>
    </view>

    <van-button
      class="primary-btn"
      type="primary"
      color="#6C5CE7"
      block
      round
      bind:click="chooseImage"
    >
      拍照 / 从相册选择
    </van-button>

    <van-button
      class="primary-btn"
      type="default"
      custom-class="outline-btn"
      block
      round
      disabled="{{!imagePath || blending}}"
      loading="{{blending}}"
      bind:click="onBlend"
    >
      {{blending ? '溶图中...' : '开始溶图'}}
    </van-button>
  </view>

  <van-overlay show="{{blending}}" z-index="100">
    <view class="overlay-panel">
      <view class="overlay-card">
        <image class="overlay-avatar" src="{{characterImage}}" mode="aspectFill" />
        <van-loading size="28px" color="#6C5CE7" vertical>
          {{characterName}} 正在走向你的生活...
        </van-loading>
      </view>
    </view>
  </van-overlay>
</view>
