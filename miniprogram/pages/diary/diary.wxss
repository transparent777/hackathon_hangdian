.diary-page .container {
  padding-bottom: 48rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-header__title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-header__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* 每条日记 = 描边方框 + 内部草稿纸 */
.diary-entry,
.empty-state {
  position: relative;
  margin-bottom: 32rpx;
  padding: 0;
  overflow: hidden;
  background: #fffef8;
}

.diary-entry__paper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.diary-entry__body {
  position: relative;
  z-index: 1;
  padding: 28rpx;
}

.entry--tilt-left {
  transform: rotate(-0.6deg);
}

.entry--tilt-right {
  transform: rotate(0.6deg);
}

.entry-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 600;
}

.entry-date__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
  border: 2rpx solid var(--color-ink);
}

/* 纯 CSS 拍立得：左右细白边、上下粗白边、外圈黑框，尺寸跟随照片 */
.polaroid {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: var(--border-sketch);
  box-shadow: var(--shadow-soft);
  padding: 32rpx 14rpx 52rpx;
}

.polaroid__photo-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.polaroid__photo {
  display: block;
  width: 100%;
  height: auto;
  vertical-align: top;
}

.polaroid__sticker {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid #2d3436;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-soft);
}

.polaroid__caption {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 2rpx;
}

.entry-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.entry-meta__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #2d3436;
}

.entry-meta__info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.entry-meta__name {
  font-size: 28rpx;
  font-weight: 700;
}

.entry-note {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 48rpx;
  border-radius: 16rpx;
  line-height: 1.8;
  background: rgba(255, 255, 255, 0.55);
}

.entry-note__mark {
  position: absolute;
  left: 16rpx;
  top: 20rpx;
  font-size: 28rpx;
  opacity: 0.6;
}

.entry-note__text {
  display: block;
}

.note--naiwa {
  border: 2rpx dashed #e17055;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  transform: rotate(-0.5deg);
}

.note--naiwa.note--rare {
  font-size: 30rpx;
  font-weight: 600;
  border-style: solid;
  box-shadow: 0 8rpx 0 rgba(225, 112, 85, 0.15);
}

.note--naiwa.note--legendary {
  font-size: 32rpx;
  font-weight: 700;
  border: 3rpx solid #f39c12;
  box-shadow: 0 12rpx 0 rgba(243, 156, 18, 0.2);
}

.note--doro {
  border: 2rpx solid #fd79a8;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #6c5ce7;
  letter-spacing: 2rpx;
}

.note--doro.note--rare {
  font-size: 28rpx;
  border-width: 3rpx;
}

.note--doro.note--legendary {
  font-size: 30rpx;
  border-color: #e84393;
  box-shadow: 0 8rpx 24rpx rgba(232, 67, 147, 0.15);
}

.note--maodie {
  border-left: 6rpx solid #e17055;
  font-size: 28rpx;
  font-style: italic;
  transform: rotate(0.8deg);
  color: #2d3436;
}

.note--maodie.note--rare {
  font-size: 30rpx;
  font-weight: 600;
  border-left-width: 8rpx;
  border-left-color: #d63031;
}

.note--maodie.note--legendary {
  font-size: 32rpx;
  font-weight: 700;
  border-left: 8rpx solid #b71540;
  box-shadow: 4rpx 4rpx 0 rgba(45, 52, 54, 0.1);
}

.diary-end {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.empty-state {
  margin-top: 40rpx;
  min-height: 480rpx;
}

.empty-state__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16rpx;
  padding: 80rpx 32rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-state__sub {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.empty-btn {
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  border: var(--border-sketch);
  box-shadow: var(--shadow-soft);
}
