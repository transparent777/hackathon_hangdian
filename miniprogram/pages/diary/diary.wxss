.diary-page .container {
  padding-bottom: 48rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-header__title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-header__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.diary-scroll {
  height: calc(100vh - 220rpx);
}

.diary-entry {
  margin-bottom: 32rpx;
  padding: 28rpx;
  background: #fffef8;
}

.entry--tilt-left {
  transform: rotate(-0.6deg);
}

.entry--tilt-right {
  transform: rotate(0.6deg);
}

.entry-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 600;
}

.entry-date__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
  border: 2rpx solid var(--color-ink);
}

.polaroid {
  padding: 16rpx;
  background: #fff;
  border: var(--border-sketch);
  border-radius: 12rpx;
  box-shadow: var(--shadow-soft);
}

.polaroid__frame {
  position: relative;
  width: 100%;
  height: 480rpx;
  border: 2rpx solid #2d3436;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f1f2f6;
}

.polaroid__photo {
  width: 100%;
  height: 100%;
}

.polaroid__sticker {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 160rpx;
  height: 160rpx;
  border: 2rpx solid #2d3436;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow-soft);
}

.polaroid__caption {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.entry-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.entry-meta__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #2d3436;
}

.entry-meta__info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.entry-meta__name {
  font-size: 28rpx;
  font-weight: 700;
}

.entry-note {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 48rpx;
  border-radius: 16rpx;
  line-height: 1.8;
}

.entry-note__mark {
  position: absolute;
  left: 16rpx;
  top: 20rpx;
  font-size: 28rpx;
  opacity: 0.6;
}

.entry-note__text {
  display: block;
}

/* 奶蛙 · 荒诞狂笑体 */
.note--naiwa {
  background: linear-gradient(135deg, #fff9e6 0%, #fff3d6 100%);
  border: 2rpx dashed #e17055;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  transform: rotate(-0.5deg);
}

.note--naiwa.note--rare {
  font-size: 30rpx;
  font-weight: 600;
  border-style: solid;
  box-shadow: 0 8rpx 0 rgba(225, 112, 85, 0.15);
}

.note--naiwa.note--legendary {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
  border: 3rpx solid #f39c12;
  box-shadow: 0 12rpx 0 rgba(243, 156, 18, 0.2);
}

/* doro · 呆萌奶音体 */
.note--doro {
  background: #fff5f8;
  border: 2rpx solid #fd79a8;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #6c5ce7;
  letter-spacing: 2rpx;
}

.note--doro.note--rare {
  font-size: 28rpx;
  background: #ffeef3;
  border-width: 3rpx;
}

.note--doro.note--legendary {
  font-size: 30rpx;
  background: linear-gradient(135deg, #ffeef3 0%, #ffeaa7 100%);
  border-color: #e84393;
  box-shadow: 0 8rpx 24rpx rgba(232, 67, 147, 0.15);
}

/* 耄耋 · 暴躁潦草体 */
.note--maodie {
  background: #faf6f0;
  border-left: 6rpx solid #e17055;
  font-size: 28rpx;
  font-style: italic;
  transform: rotate(0.8deg);
  color: #2d3436;
}

.note--maodie.note--rare {
  font-size: 30rpx;
  font-weight: 600;
  border-left-width: 8rpx;
  border-left-color: #d63031;
}

.note--maodie.note--legendary {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #faf6f0 0%, #ffeaa7 100%);
  border-left: 8rpx solid #b71540;
  box-shadow: 4rpx 4rpx 0 rgba(45, 52, 54, 0.1);
}

.diary-end {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.empty-state {
  margin-top: 40rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-state__sub {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.empty-btn {
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  border: var(--border-sketch);
  box-shadow: var(--shadow-soft);
}
