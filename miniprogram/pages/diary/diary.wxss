.diary-page .container {
  padding-bottom: 48rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-header__title {
  font-size: 40rpx;
  font-weight: 800;
}

.page-header__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* 每条日记 = 描边方框 + 内部草稿纸 */
.diary-entry,
.empty-state {
  position: relative;
  margin-bottom: 32rpx;
  padding: 0;
  overflow: hidden;
  background: #fffef8;
}

.diary-entry__paper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.diary-entry__body {
  position: relative;
  z-index: 1;
  padding: 28rpx;
}

.entry--tilt-left {
  transform: rotate(-0.6deg);
}

.entry--tilt-right {
  transform: rotate(0.6deg);
}

.entry-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 600;
}

.entry-date__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent);
  border: 2rpx solid var(--color-ink);
}

/* 纯 CSS 拍立得：左右细白边、上下粗白边、外圈黑框，尺寸跟随照片 */
.polaroid {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: var(--border-sketch);
  box-shadow: var(--shadow-soft);
  /* 上粗 44 / 左右细 14 / 下粗 56 */
  padding: 44rpx 14rpx 56rpx;
}

.polaroid__photo-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.polaroid__photo {
  display: block;
  width: 100%;
  height: auto;
  vertical-align: top;
}

.polaroid__sticker {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid #2d3436;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 2rpx 4rpx 0 rgba(45, 52, 54, 0.12);
}

.entry-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.entry-meta__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #2d3436;
}

.entry-meta__name {
  font-size: 28rpx;
  font-weight: 700;
}

.name--naiwa {
  color: #e17055;
  font-family: 'STXingkai', 'KaiTi', serif;
}

.name--doro {
  color: #6c5ce7;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

.name--maodie {
  color: #0984e3;
  font-family: 'PingFang SC', sans-serif;
  font-style: italic;
  font-weight: 800;
}

.entry-note {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 48rpx;
  border-radius: 16rpx;
  line-height: 1.8;
  background: rgba(255, 255, 255, 0.55);
}

.entry-note__mark {
  position: absolute;
  left: 16rpx;
  top: 20rpx;
  font-size: 28rpx;
  opacity: 0.6;
}

.entry-note__text {
  display: block;
}

.entry-note--empty {
  border: 2rpx dashed #dfe6e9;
  background: rgba(255, 255, 255, 0.35);
  color: #95a5a6;
  font-size: 24rpx;
  padding-left: 24rpx;
}

/* 奶蛙 · 橙色 · 行书 */
.note--naiwa {
  border: 2rpx dashed #e17055;
  background: rgba(255, 234, 200, 0.4);
  font-family: 'STXingkai', 'KaiTi', 'STKaiti', serif;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: #e17055;
  transform: rotate(-0.5deg);
}

.note--naiwa.note--rare {
  font-size: 30rpx;
  font-weight: 600;
  border-style: solid;
  color: #d35400;
  box-shadow: 0 8rpx 0 rgba(225, 112, 85, 0.15);
}

.note--naiwa.note--legendary {
  font-size: 32rpx;
  font-weight: 700;
  color: #e67e22;
  border: 3rpx solid #f39c12;
  background: rgba(255, 243, 205, 0.55);
  box-shadow: 0 12rpx 0 rgba(243, 156, 18, 0.2);
}

/* doro · 紫色 · 宋体 */
.note--doro {
  border: 2rpx solid #a29bfe;
  border-radius: 20rpx;
  background: rgba(162, 155, 254, 0.12);
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: #6c5ce7;
}

.note--doro.note--rare {
  font-size: 28rpx;
  border-width: 3rpx;
  border-color: #6c5ce7;
  color: #5f4dd6;
}

.note--doro.note--legendary {
  font-size: 30rpx;
  border-color: #5f27cd;
  color: #4a3fb8;
  background: rgba(108, 92, 231, 0.15);
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.15);
}

/* 耄耋 · 蓝色 · 狂野潦草（非行楷） */
.note--maodie {
  border-left: 6rpx solid #0984e3;
  background: rgba(116, 185, 255, 0.1);
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  font-style: italic;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  transform: rotate(1deg) skewX(-2deg);
  color: #0984e3;
}

.note--maodie.note--rare {
  font-size: 30rpx;
  border-left-width: 8rpx;
  border-left-color: #0652dd;
  color: #0652dd;
}

.note--maodie.note--legendary {
  font-size: 32rpx;
  font-weight: 900;
  border-left: 8rpx solid #1e3799;
  color: #1e3799;
  background: rgba(9, 132, 227, 0.14);
  box-shadow: 4rpx 4rpx 0 rgba(9, 132, 227, 0.12);
}

.diary-end {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.empty-state {
  margin-top: 40rpx;
  min-height: 480rpx;
}

.empty-state__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16rpx;
  padding: 80rpx 32rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-state__sub {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.empty-btn {
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  border: var(--border-sketch);
  box-shadow: var(--shadow-soft);
}
