.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: #3d5a80;
  border-top: 4rpx solid #2d3436;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 0 rgba(45, 52, 54, 0.12);
  z-index: 999;
}

.tab-bar__brand {
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  padding: 12rpx 0 4rpx;
  letter-spacing: 2rpx;
}

.tab-bar__nav {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 16rpx 16rpx;
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 96rpx;
  position: relative;
  z-index: 1;
}

.tab-bar__text {
  font-size: 22rpx;
  color: #b2bec3;
  font-weight: 600;
}

.tab-bar__item--active .tab-bar__text {
  color: #ffe66d;
}
