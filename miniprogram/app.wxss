page {
  background: #f7f8fc;
  color: #2d3436;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d3436;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #636e72;
  line-height: 1.6;
}

.primary-btn {
  margin-top: 32rpx;
}
